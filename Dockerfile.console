# 形态 B：带 UI + 账号池的反代（多文件，仍零 npm 依赖）
#
# 与 Dockerfile（单文件形态）的区别：
#   - 同一个端口 3050，核心与 console 共用一个 http.Server（不是两个进程两个口）
#   - 多 copy 了 console/ 目录
#   - 数据（账号密文 + 状态）放在卷 /data，容器重建不丢
#
# 用法：
#   docker build -f Dockerfile.console -t commandcode-proxy:console .
#   docker run -d -p 3050:3050 -v cc-data:/data \
#     -e CC_ADMIN_PASSWORD='换成你的口令（≥8 位）' commandcode-proxy:console
#
# 注意：
#   - 不设 CC_ADMIN_PASSWORD 时，池不会启用，行为与单文件形态一致（只是多了 UI）
#   - 口令丢失 = 账号密文无法解密（设计 D6 的取舍），请自行备份口令
#   - console 默认只接受回环来源；容器里要访问 UI 请用
#       docker exec -it <容器> wget -qO- http://127.0.0.1:3050/api/console/gate
#       （/api/console/* 现在全部要管理会话，只有 /auth 登录与 /gate 探针公开）
#     或在宿主机做端口转发后经 127.0.0.1 访问（设计 Q2：读口只认回环）
FROM node:22-alpine

WORKDIR /app

# 核心（单文件）+ 可选层（console/）。零依赖，不需要 npm install
COPY package.json proxy.mjs ./
COPY console/ ./console/

ENV PORT=3050 \
    HOST=0.0.0.0 \
    CC_POOL_DB=/data/pool.db

RUN mkdir -p /data
VOLUME ["/data"]

EXPOSE 3050

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --spider http://127.0.0.1:3050/health || exit 1

# 形态 B 的入口：核心与 console 同一个进程、同一个端口
CMD ["node", "console/server.mjs"]
